+++ b/rtamt/semantics/stl/discrete_time/online/cpp/ast_visitor.py
@@ -181,3 +181,16 @@ class StlDiscreteTimeOnlineAstVisitorCpp(StlAstVisitor):
             return StlComparisonOperator.EQUAL
         else:
             raise RTAMTException('Could not find operator {}!'.format(op))
+
+
+# --- PATCH: visitVariable was missing from the C++ ast_visitor ---
+# The pure Python visitor (python/ast_visitor.py) has this; the cpp one does not.
+# Without it, variables are never registered in online_operator_dict,
+# causing a KeyError on the first update() call.
+from rtamt.semantics.stl.discrete_time.online.variable_operation import VariableOperation as _VariableOperation
+
+def _visitVariable(self, node, *args, **kwargs):
+    self.visitChildren(node, *args, **kwargs)
+    self.online_operator_dict[node.name] = _VariableOperation()
+
+StlDiscreteTimeOnlineAstVisitorCpp.visitVariable = _visitVariable
